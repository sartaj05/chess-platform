DJANGO_SETTINGS_MODULE=chess_platform.settings.prod
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=chess.example.com
CSRF_TRUSTED_ORIGINS=https://chess.example.com
POSTGRES_DB=chess_platform
POSTGRES_USER=chess_platform
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://chess_platform:REPLACE_WITH_A_STRONG_DATABASE_PASSWORD@db:5432/chess_platform
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=REPLACE_ME
EMAIL_HOST_PASSWORD=REPLACE_ME
DEFAULT_FROM_EMAIL=Chess Platform <noreply@chess.example.com>
STOCKFISH_BINARY=/usr/games/stockfish
STOCKFISH_DEFAULT_DEPTH=12
STOCKFISH_DEFAULT_MOVETIME_MS=750
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128
DJANGO_SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
