DJANGO_SETTINGS_MODULE=chess_platform.settings.prod
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=chess.example.com
CSRF_TRUSTED_ORIGINS=https://chess.example.com
CORS_ALLOWED_ORIGINS=https://chess.example.com

POSTGRES_DB=chess_platform
POSTGRES_USER=chess
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgres://chess:replace-with-a-strong-database-password@db:5432/chess_platform

REDIS_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Chess Platform <noreply@chess.example.com>

DJANGO_SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

STOCKFISH_BINARY=/usr/games/stockfish
STOCKFISH_DEFAULT_DEPTH=12
STOCKFISH_DEFAULT_MOVETIME_MS=750
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=64
ANALYSIS_REVIEW_DEPTH=10
