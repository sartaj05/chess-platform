DJANGO_SETTINGS_MODULE=chess_platform.settings.dev
DJANGO_SECRET_KEY=change-this-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,192.168.11.47
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000
DATABASE_URL=postgres://chess:chess_password@db:5432/chess_platform
REDIS_URL=redis://redis:6379/0
CHANNEL_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Chess Platform <noreply@localhost>
USER_ACTIVITY_CACHE_TTL=180
API_THROTTLE_ROOM_WRITE_ANON=60/hour
API_THROTTLE_ROOM_WRITE_USER=180/hour
API_THROTTLE_ANALYSIS_ANON=10/hour
API_THROTTLE_ANALYSIS_USER=60/hour
API_THROTTLE_OFFLINE_SYNC=120/hour
DJANGO_SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Offline Stockfish engine
STOCKFISH_BINARY=/usr/games/stockfish
STOCKFISH_DEFAULT_DEPTH=12
STOCKFISH_DEFAULT_MOVETIME_MS=750
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=64
ANALYSIS_REVIEW_DEPTH=10
